# 3
USD_TO_RUB = 95.50
def convert_usd_to_rub(amount_usd):
    return amount_usd * USD_TO_RUB
usd_amount = float(input("Введите сумму в долларах (USD): "))
rub_amount = convert_usd_to_rub(usd_amount)
print(f"Сумма в рублях: {rub_amount:,.2f} руб.".replace(",", " "))





# 4
import math
PI = math.pi
def calculate_rectangle_area(width, height):
    return width * height
def calculate_circle_area(radius):
    """Считает площадь круга."""
    return PI * (radius ** 2)
w, h = map(float, input("Введите ширину и высоту прямоугольника через пробел: ").split())
print(f"Площадь прямоугольника: {calculate_rectangle_area(w, h):.2f}")
r = float(input("Введите радиус круга: "))
print(f"Площадь круга: {calculate_circle_area(r):.2f}")




# 5
BANKNOTES = (5000, 2000, 1000, 500, 200, 100)
amount = int(input("Введите сумму для снятия (кратную 100): "))
print("Выданные купюры:")
for note in BANKNOTES:
    if amount >= note:
        count = amount // note  
        amount = amount % note  
        print(f"Купюры номиналом {note} руб.: {count} шт.")



