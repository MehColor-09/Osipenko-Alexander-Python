# 1
temp = float(input("Введите температуру: "))
press = int(input("Введите давление: "))
pulse = int(input("Введите пульс: "))

if (temp < 35.0 or temp > 38.0) or \
   (press < 105 or press > 140) or \
   (pulse < 55 or pulse > 110):
    print("Состояние: Требуется врач")
elif (35.0 <= temperature < 36.0 or 37.0 < temperature <= 38.0) or \
     (105 <= press < 110 or 130 < press <= 140) or \
     (55 <= pulse < 60 or 100 < pulse <= 110):
    print("Состояние: Легкое недомогание")
else:
    print("Состояние: Нормальное состояние")




# 2
num = int(input("Введите номер кармана рулетки: "))
if num < 0 or num > 36:
    print("ошибка ввода")
elif num == 0:
    print("Зеро")
elif 1 <= num <= 10:
    if num % 2 != 0:
        print("Красное")
    else:
        print("Черное")
elif 11 <= num <= 18:
    if num % 2 != 0:
        print("Черное")
    else:
        print("Красный")
elif 19 <= num <= 28:
    if num % 2 != 0:
        print("Красное")
    else:
        print("Черное")
elif 29 <= num <= 36:
    if num % 2 != 0:
        print("Черное")
    else:
        print("Красное")



# 3 
# Считывание координат двух клеток
col1 = int(input("Столбец 1-й клетки (1-8): "))
row1 = int(input("Строка 1-й клетки (1-8): "))
col2 = int(input("Столбец 2-й клетки (1-8): "))
row2 = int(input("Строка 2-й клетки (1-8): "))
if (col1 + row1) % 2 == (col2 + row2) % 2:
    print("YES")
else:
    print("NO")




